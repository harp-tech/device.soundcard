<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>App for configuring and testing Harp SoundCard devices.</Description>
    <PackageTags>$(PackageTags) App</PackageTags>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <RollForward>Major</RollForward>
    <OutputType>WinExe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>harp.soundcard</ToolCommandName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Harp.SoundCard.Design\Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="libusb.runtime" Version="1.0.27" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harp.SoundCard.Design\Harp.SoundCard.Design.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(Pkglibusb_runtime)\NOTICE.txt" Link="licenses\libusb\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(Pkglibusb_runtime)\LICENSE" Link="licenses\libusb\LICENSE" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
