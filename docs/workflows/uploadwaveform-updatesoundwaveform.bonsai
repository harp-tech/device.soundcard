<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:Harp.SoundCard;assembly=Harp.SoundCard"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:UpdateSoundWaveform">
          <p1:DeviceIndex xsi:nil="true" />
          <p1:SoundIndex>3</p1:SoundIndex>
          <p1:SoundName>bonsai-sound</p1:SoundName>
          <p1:SampleRate>SampleRate96000Hz</p1:SampleRate>
        </Combinator>
      </Expression>
    </Nodes>
    <Edges />
  </Workflow>
</WorkflowBuilder>