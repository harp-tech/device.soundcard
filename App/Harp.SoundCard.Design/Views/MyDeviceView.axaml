                      <x:Static Member="local:DigitalInputConfiguration.Digital" />
                      <x:Static Member="local:DigitalInputConfiguration.StartAndStopSound" />
                      <x:Static Member="local:DigitalInputConfiguration.StartSound" />
                      <x:Static Member="local:DigitalInputConfiguration.Stop" />
                      <x:Static Member="local:DigitalInputConfiguration.StartAndStopFrequency" />
                      <x:Static Member="local:DigitalInputConfiguration.StartFrequency" />
                    </ComboBox>
                  </StackPanel>
                  <!-- Register: ConfigureDO0 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">ConfigureDO0</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Configuration of the digital output 0 (DO0)</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <ComboBox SelectedItem="{Binding ConfigureDO0, Mode=TwoWay}"
                              IsEnabled="True"
                              Width="200"
                              Margin="0,5,0,0"
                              HorizontalAlignment="Left">
                      <ComboBox.Resources>
                        <conv:EnumDisplayConverter x:Key="EnumDisplayConverter">
                          <conv:EnumDisplayConverter.Mappings>
                            <system:String x:Key="Digital">Used as a pure digital output.</system:String>
                            <system:String x:Key="Pulse">The digital output will be high during a period specified by register DOxPulse.</system:String>
                            <system:String x:Key="HighWhenSound">High when the sound is being played.</system:String>
                            <system:String x:Key="Pulse1MsWhenStart">High when sound starts during 1 ms.</system:String>
                            <system:String x:Key="Pulse10MsWhenStart">High when sound starts during 10 ms.</system:String>
                            <system:String x:Key="Pulse100MsWhenStart">High when sound starts during 100 ms.</system:String>
                            <system:String x:Key="Pulse1MsWhenStop">High when sound stops during 1 ms.</system:String>
                            <system:String x:Key="Pulse10MsWhenStop">High when sound stops during 10 ms.</system:String>
                            <system:String x:Key="Pulse100MsWhenStop">High when sound starts during 100 ms.</system:String>
                          </conv:EnumDisplayConverter.Mappings>
                        </conv:EnumDisplayConverter>
                      </ComboBox.Resources>
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <x:Static Member="local:DigitalOutputConfiguration.Digital" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse" />
                      <x:Static Member="local:DigitalOutputConfiguration.HighWhenSound" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse1MsWhenStart" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse10MsWhenStart" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse100MsWhenStart" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse1MsWhenStop" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse10MsWhenStop" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse100MsWhenStop" />
                    </ComboBox>
                  </StackPanel>
                  <!-- Register: ConfigureDO1 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">ConfigureDO1</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Configuration of the digital output 1 (DO1)</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <ComboBox SelectedItem="{Binding ConfigureDO1, Mode=TwoWay}"
                              IsEnabled="True"
                              Width="200"
                              Margin="0,5,0,0"
                              HorizontalAlignment="Left">
                      <ComboBox.Resources>
                        <conv:EnumDisplayConverter x:Key="EnumDisplayConverter">
                          <conv:EnumDisplayConverter.Mappings>
                            <system:String x:Key="Digital">Used as a pure digital output.</system:String>
                            <system:String x:Key="Pulse">The digital output will be high during a period specified by register DOxPulse.</system:String>
                            <system:String x:Key="HighWhenSound">High when the sound is being played.</system:String>
                            <system:String x:Key="Pulse1MsWhenStart">High when sound starts during 1 ms.</system:String>
                            <system:String x:Key="Pulse10MsWhenStart">High when sound starts during 10 ms.</system:String>
                            <system:String x:Key="Pulse100MsWhenStart">High when sound starts during 100 ms.</system:String>
                            <system:String x:Key="Pulse1MsWhenStop">High when sound stops during 1 ms.</system:String>
                            <system:String x:Key="Pulse10MsWhenStop">High when sound stops during 10 ms.</system:String>
                            <system:String x:Key="Pulse100MsWhenStop">High when sound starts during 100 ms.</system:String>
                          </conv:EnumDisplayConverter.Mappings>
                        </conv:EnumDisplayConverter>
                      </ComboBox.Resources>
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <x:Static Member="local:DigitalOutputConfiguration.Digital" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse" />
                      <x:Static Member="local:DigitalOutputConfiguration.HighWhenSound" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse1MsWhenStart" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse10MsWhenStart" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse100MsWhenStart" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse1MsWhenStop" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse10MsWhenStop" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse100MsWhenStop" />
                    </ComboBox>
                  </StackPanel>
                  <!-- Register: ConfigureDO2 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">ConfigureDO2</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Configuration of the digital output 2 (DO2</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <ComboBox SelectedItem="{Binding ConfigureDO2, Mode=TwoWay}"
                              IsEnabled="True"
                              Width="200"
                              Margin="0,5,0,0"
                              HorizontalAlignment="Left">
                      <ComboBox.Resources>
                        <conv:EnumDisplayConverter x:Key="EnumDisplayConverter">
                          <conv:EnumDisplayConverter.Mappings>
                            <system:String x:Key="Digital">Used as a pure digital output.</system:String>
                            <system:String x:Key="Pulse">The digital output will be high during a period specified by register DOxPulse.</system:String>
                            <system:String x:Key="HighWhenSound">High when the sound is being played.</system:String>
                            <system:String x:Key="Pulse1MsWhenStart">High when sound starts during 1 ms.</system:String>
                            <system:String x:Key="Pulse10MsWhenStart">High when sound starts during 10 ms.</system:String>
                            <system:String x:Key="Pulse100MsWhenStart">High when sound starts during 100 ms.</system:String>
                            <system:String x:Key="Pulse1MsWhenStop">High when sound stops during 1 ms.</system:String>
                            <system:String x:Key="Pulse10MsWhenStop">High when sound stops during 10 ms.</system:String>
                            <system:String x:Key="Pulse100MsWhenStop">High when sound starts during 100 ms.</system:String>
                          </conv:EnumDisplayConverter.Mappings>
                        </conv:EnumDisplayConverter>
                      </ComboBox.Resources>
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <x:Static Member="local:DigitalOutputConfiguration.Digital" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse" />
                      <x:Static Member="local:DigitalOutputConfiguration.HighWhenSound" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse1MsWhenStart" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse10MsWhenStart" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse100MsWhenStart" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse1MsWhenStop" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse10MsWhenStop" />
                      <x:Static Member="local:DigitalOutputConfiguration.Pulse100MsWhenStop" />
                    </ComboBox>
                  </StackPanel>
                  <!-- Register: FrequencyDI0 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">FrequencyDI0</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Specifies the sound frequency to be played when triggering DI0</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding FrequencyDI0}"
                                   Minimum="0"
                                   Maximum="65535"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: FrequencyDI1 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">FrequencyDI1</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Specifies the sound frequency to be played when triggering DI1</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding FrequencyDI1}"
                                   Minimum="0"
                                   Maximum="65535"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: FrequencyDI2 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">FrequencyDI2</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Specifies the sound frequency to be played when triggering DI2</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding FrequencyDI2}"
                                   Minimum="0"
                                   Maximum="65535"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: InputState (Read-Only, Event) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">InputState</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>State of the digital inputs</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <controls:VisualStatus Status="{Binding IsDI0Enabled_InputState}"
                                             Width="15" Height="15" />
                      <TextBlock Text="DI0" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                  <!-- Register: OutputClear (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">OutputClear</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Clear the specified digital output lines</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding IsDO0Enabled_OutputClear}"
                              IsEnabled="True">
                      DO0
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsDO1Enabled_OutputClear}"
                              IsEnabled="True">
                      DO1
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsDO2Enabled_OutputClear}"
                              IsEnabled="True">
                      DO2
                    </CheckBox>
                  </StackPanel>
                  <!-- Register: OutputSet (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">OutputSet</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Set the specified digital output lines</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding IsDO0Enabled_OutputSet}"
                              IsEnabled="True">
                      DO0
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsDO1Enabled_OutputSet}"
                              IsEnabled="True">
                      DO1
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsDO2Enabled_OutputSet}"
                              IsEnabled="True">
                      DO2
                    </CheckBox>
                  </StackPanel>
                  <!-- Register: OutputState (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">OutputState</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Write the state of all digital output lines</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding IsDO0Enabled_OutputState}"
                              IsEnabled="True">
                      DO0
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsDO1Enabled_OutputState}"
                              IsEnabled="True">
                      DO1
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsDO2Enabled_OutputState}"
                              IsEnabled="True">
                      DO2
                    </CheckBox>
                  </StackPanel>
                  <!-- Register: OutputToggle (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">OutputToggle</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Toggle the specified digital output lines</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding IsDO0Enabled_OutputToggle}"
                              IsEnabled="True">
                      DO0
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsDO1Enabled_OutputToggle}"
                              IsEnabled="True">
                      DO1
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsDO2Enabled_OutputToggle}"
                              IsEnabled="True">
                      DO2
                    </CheckBox>
                  </StackPanel>
                  <!-- Register: PlaySoundOrFrequency (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">PlaySoundOrFrequency</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Starts the sound index (if less than 32) or frequency (if greater or equal than 32)</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding PlaySoundOrFrequency}"
                                   Minimum="0"
                                   Maximum="65535"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: PulseDO0 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">PulseDO0</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Pulse for the digital output 0 (DO0)</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding PulseDO0}"
                                   Minimum="1"
                                   Maximum="255"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: PulseDO1 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">PulseDO1</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Pulse for the digital output 1 (DO1)</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding PulseDO1}"
                                   Minimum="1"
                                   Maximum="255"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: PulseDO2 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">PulseDO2</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Pulse for the digital output 2 (DO2)</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding PulseDO2}"
                                   Minimum="1"
                                   Maximum="255"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: SoundIndexDI0 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">SoundIndexDI0</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Specifies the sound index to be played when triggering DI0</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding SoundIndexDI0}"
                                   Minimum="0"
                                   Maximum="255"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: SoundIndexDI1 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">SoundIndexDI1</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Specifies the sound index to be played when triggering DI1</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding SoundIndexDI1}"
                                   Minimum="0"
                                   Maximum="255"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: SoundIndexDI2 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">SoundIndexDI2</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Specifies the sound index to be played when triggering DI2</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding SoundIndexDI2}"
                                   Minimum="0"
                                   Maximum="255"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: Stop (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">Stop</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Any value will stop the current sound</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding Stop}"
                                   Minimum="0"
                                   Maximum="255"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                </StackPanel>
                <!-- Message Control -->
                <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="2">
                  <controls:WriteMessagesControl MinWidth="500" IsVisible="{Binding ShowWriteMessages}" />
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Sound generation" FontSize="20" FontWeight="SemiBold">
              <views:SoundGenerationView DataContext="{Binding SoundGenerationViewModel}"></views:SoundGenerationView>
            </TabItem>
          </TabControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>


