<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Harp.SoundCard.Design.Controls"
             xmlns:conv="clr-namespace:Harp.SoundCard.Design.Converters"
             xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
             xmlns:local="clr-namespace:Harp.SoundCard;assembly=Harp.SoundCard"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:views="clr-namespace:Harp.SoundCard.Design.Views;assembly=Harp.SoundCard.Design"
             xmlns:vm="clr-namespace:Harp.SoundCard.Design.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Harp.SoundCard.Design.Views.SoundCardView"
             x:DataType="vm:SoundCardViewModel">

  <UserControl.Resources>
    <conv:EnableFlagConverter x:Key="EnableFlagConverter"/>
    <conv:PayloadFieldConverter x:Key="PayloadFieldConverter"/>
    <conv:VisualStatusColorConverter x:Key="VisualStatusColorConverter"/>
  </UserControl.Resources>

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:SoundCardViewModel />
  </Design.DataContext>

  <DockPanel>
    <Grid Margin="10" DockPanel.Dock="Top"
          ColumnDefinitions="Auto, Auto, *, Auto, Auto"
          RowDefinitions="30,25,*,*">
      <TextBlock Grid.Row="0"
                 Text="SoundCard"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 FontWeight="Bold"
                 FontSize="17" />
      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="2">
        <TextBlock Text="{Binding AppVersion}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   FontWeight="Bold"
                   FontSize="17"
                   Margin="5,0,0,0" />
        <Button Background="Transparent" Command="{Binding ShowAboutCommand}">
          <heroIcons:HeroIcon Foreground="{Binding IconColor}" Type="QuestionMarkCircle" Width="14"/>
        </Button>
      </StackPanel>
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Hardware &amp; Software Platform" HorizontalAlignment="Left"
                       Foreground="{StaticResource BlueAccentColor}" MaxWidth="240" VerticalAlignment="Center" FontWeight="Bold" TextWrapping="WrapWithOverflow" FontSize="12" />
        <ThemeVariantScope Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                 RequestedThemeVariant="Light">
          <Image VerticalAlignment="Center"
                 HorizontalAlignment="Right"
                 Margin="0,5,5,0"
                 IsVisible="{Binding !IsDarkMode}"
                 Source="/Assets/cf-logo.png" />
        </ThemeVariantScope>
        <ThemeVariantScope Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2"
                           RequestedThemeVariant="Dark">
          <Image VerticalAlignment="Center"
                 HorizontalAlignment="Right"
                 Margin="0,5,5,0"
                 IsVisible="{Binding IsDarkMode}"
                 Source="/Assets/cf-logo-white-lettering.png" />
        </ThemeVariantScope>
        <ToggleSwitch Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" Margin="10,0,0,0" ToolTip.Tip="Change theme"
                            Content="Theme" FontWeight="Normal" FontSize="14"
                            IsChecked="{Binding IsDarkMode}">
          <ToggleSwitch.OnContent>
            <heroIcons:HeroIcon Foreground="{Binding IconColor}" Type="Moon" Width="16" Height="16" />
          </ToggleSwitch.OnContent>
          <ToggleSwitch.OffContent>
            <heroIcons:HeroIcon Foreground="{Binding IconColor}" Type="Sun" Width="16" Height="16" />
          </ToggleSwitch.OffContent>
        </ToggleSwitch>
    </Grid>

    <Grid DockPanel.Dock="Bottom" RowDefinitions="Auto" ColumnDefinitions="Auto,*,Auto,Auto" Margin="10">
      <Button Grid.Row="0" Grid.Column="3"
              Command="{Binding SaveConfigurationCommand}"
              Content="Save configuration"
              Margin="10,0,0,0"
              Background="{StaticResource BlueAccentColor}"
              Foreground="White">
        <Button.CommandParameter>
          <system:Boolean>false</system:Boolean>
        </Button.CommandParameter>
      </Button>
      <Button Grid.Row="0" Grid.Column="2" Command="{Binding SaveConfigurationCommand}"
              Content="Save configuration permanently">
        <Button.CommandParameter>
          <system:Boolean>true</system:Boolean>
        </Button.CommandParameter>
      </Button>
      <Button Grid.Row="0" Grid.Column="0" Command="{Binding ResetConfigurationCommand}"
              Content="Reset to defaults" />
    </Grid>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" Padding="0">
      <StackPanel Spacing="12" Margin="0,20,0,0">
        <Panel Height="36">
          <TextBlock Text="Device connection" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                     Margin="10,0" />
        </Panel>
        <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="*,*" Margin="0,0,50,0" MinHeight="60">
          <StackPanel Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="10" Orientation="Horizontal"
                      Spacing="20">
            <TextBlock Text="Select a device" VerticalAlignment="Center" />
            <ComboBox Name="Ports" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                      MinWidth="70" />
            <Button Command="{Binding LoadDeviceInformation}">
              <heroIcons:HeroIcon Foreground="{Binding IconColor}" Type="ArrowPath" Width="16" Height="16" />
            </Button>
            <Button Content="{Binding ConnectButtonText}"
                    Command="{Binding ConnectAndGetBaseInfoCommand}" />
            <ToggleButton Grid.Row="0" Grid.Column="2"
                    Command="{Binding ShowMessagesCommand}">
              <heroIcons:HeroIcon Foreground="{Binding IconColor}" Type="DocumentText" Width="16" Height="16" />
            </ToggleButton>
          </StackPanel>
          <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="25,25,30,*" RowDefinitions="*,*,*"
                Margin="20, 0, 0, 0" IsVisible="{Binding Connected}">
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" VerticalAlignment="Center"
                       HorizontalAlignment="Left" Text="{Binding DeviceName}" FontWeight="Bold"
                       FontSize="24" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Hw " VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HardwareVersion}" FontWeight="Bold"
                       VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Fw " VerticalAlignment="Top" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FirmwareVersion}" FontWeight="Bold"
                       VerticalAlignment="Top" />
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Text="S/N " VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" Text="{Binding SerialNumber}"
                       FontWeight="Bold" VerticalAlignment="Center" />
          </Grid>
        </Grid>
        <StackPanel>
          <TabControl Margin="0,10,0,0">
            <TabItem Header="Configuration" FontSize="20" FontWeight="SemiBold">
              <Grid Margin="10,0,0,10" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="*,*,*,*">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Events" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Other" FontSize="16" FontWeight="SemiBold" />

                <!-- Events Column -->
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5" Margin="0,10,20,0">
                  <!-- Register: EnableEvents (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">EnableEvents</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Specifies the active events in the SoundCard device</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding IsPlaySoundOrFrequencyEnabled}"
                              IsEnabled="True">
                      PlaySoundOrFrequency
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsStopEnabled}"
                              IsEnabled="True">
                      Stop
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsDigitalInputsEnabled}"
                              IsEnabled="True">
                      DigitalInputs
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsAdcValuesEnabled}"
                              IsEnabled="True">
                      AdcValues
                    </CheckBox>
                  </StackPanel>
                </StackPanel>

                <!-- Other Column -->
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="20" Margin="0,10,0,0">
                  <!-- Register: AnalogData (Read-Only, Event) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AnalogData</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Contains sampled analog input data or dynamic sound parameters controlled by the ADC channels. Values are zero if not used.</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0"
                                 Text="Adc0:"
                                 VerticalAlignment="Center"
                                 Margin="0,5,10,5" />
                      <TextBlock Grid.Row="0" Grid.Column="1"
                                 Text="{Binding AnalogData,
                                Converter={StaticResource PayloadFieldConverter},
                                ConverterParameter='Adc0'}"
                                 VerticalAlignment="Center"
                                 Margin="0,5,0,5"
                                 FontSize="14" />
                      <TextBlock Grid.Row="1" Grid.Column="0"
                                 Text="Adc1:"
                                 VerticalAlignment="Center"
                                 Margin="0,5,10,5" />
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="{Binding AnalogData,
                                Converter={StaticResource PayloadFieldConverter},
                                ConverterParameter='Adc1'}"
                               VerticalAlignment="Center"
                               Margin="0,5,0,5"
                               FontSize="14" />
                      <TextBlock Grid.Row="2" Grid.Column="0"
                                 Text="AttenuationLeft:"
                                 VerticalAlignment="Center"
                                 Margin="0,5,10,5" />
                      <TextBlock Grid.Row="2" Grid.Column="1"
                                 Text="{Binding AnalogData,
                                Converter={StaticResource PayloadFieldConverter},
                                ConverterParameter='AttenuationLeft'}"
                                 VerticalAlignment="Center"
                                 Margin="0,5,0,5"
                                 FontSize="14" />
                      <TextBlock Grid.Row="3" Grid.Column="0"
                                 Text="AttenuationRight:"
                                 VerticalAlignment="Center"
                                 Margin="0,5,10,5" />
                      <TextBlock Grid.Row="3" Grid.Column="1"
                                 Text="{Binding AnalogData,
                                Converter={StaticResource PayloadFieldConverter},
                                ConverterParameter='AttenuationRight'}"
                                 VerticalAlignment="Center"
                                 Margin="0,5,0,5"
                                 FontSize="14" />
                      <TextBlock Grid.Row="4" Grid.Column="0"
                                 Text="Frequency:"
                                 VerticalAlignment="Center"
                                 Margin="0,5,10,5" />
                      <TextBlock Grid.Row="4" Grid.Column="1"
                                 Text="{Binding AnalogData,
                                Converter={StaticResource PayloadFieldConverter},
                                ConverterParameter='Frequency'}"
                                 VerticalAlignment="Center"
                                 Margin="0,5,0,5"
                                 FontSize="14" />
                    </Grid>
                  </StackPanel>
                  <!-- Register: AttenuationAndFrequencyDI0 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationAndFrequencyDI0</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Sound index and attenuation to be played when triggering DI0 [Att BOTH] [Frequency]</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <Border CornerRadius="3" Padding="5" MaxHeight="200">
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding AttenuationAndFrequencyDI0Collection}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="50,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='[{0}]:'}"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Value}"
                                               Minimum="0"
                                               Maximum="65535"
                                               Increment="1"
                                               FormatString="F0"
                                               ClipValueToMinMax="True"
                                               Width="150" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                  <!-- Register: AttenuationAndFrequencyDI1 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationAndFrequencyDI1</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Sound index and attenuation to be played when triggering DI1 [Att BOTH] [Frequency]</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <Border CornerRadius="3" Padding="5" MaxHeight="200">
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding AttenuationAndFrequencyDI1Collection}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="50,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='[{0}]:'}"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Value}"
                                               Minimum="0"
                                               Maximum="65535"
                                               Increment="1"
                                               FormatString="F0"
                                               ClipValueToMinMax="True"
                                               Width="150" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                  <!-- Register: AttenuationAndFrequencyDI2 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationAndFrequencyDI2</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Sound index and attenuation to be played when triggering DI2 [Att BOTH] [Frequency]</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <Border CornerRadius="3" Padding="5" MaxHeight="200">
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding AttenuationAndFrequencyDI2Collection}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="50,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='[{0}]:'}"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Value}"
                                               Minimum="0"
                                               Maximum="65535"
                                               Increment="1"
                                               FormatString="F0"
                                               ClipValueToMinMax="True"
                                               Width="150" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                  <!-- Register: AttenuationAndPlaySoundOrFreq (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationAndPlaySoundOrFreq</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Configures attenuation and plays sound index [Att R] [Att L] [Index]</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <Border CornerRadius="3" Padding="5" MaxHeight="200">
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding AttenuationAndPlaySoundOrFreqCollection}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="50,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='[{0}]:'}"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Value}"
                                               Minimum="0"
                                               Maximum="65535"
                                               Increment="1"
                                               FormatString="F0"
                                               ClipValueToMinMax="True"
                                               Width="150" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                  <!-- Register: AttenuationAndSoundIndexDI0 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationAndSoundIndexDI0</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Sound index and attenuation to be played when triggering DI0 [Att R] [Att L] [Index]</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <Border CornerRadius="3" Padding="5" MaxHeight="200">
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding AttenuationAndSoundIndexDI0Collection}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="50,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='[{0}]:'}"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Value}"
                                               Minimum="0"
                                               Maximum="65535"
                                               Increment="1"
                                               FormatString="F0"
                                               ClipValueToMinMax="True"
                                               Width="150" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                  <!-- Register: AttenuationAndSoundIndexDI1 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationAndSoundIndexDI1</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Sound index and attenuation to be played when triggering DI1 [Att R] [Att L] [Index]</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <Border CornerRadius="3" Padding="5" MaxHeight="200">
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding AttenuationAndSoundIndexDI1Collection}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="50,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='[{0}]:'}"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Value}"
                                               Minimum="0"
                                               Maximum="65535"
                                               Increment="1"
                                               FormatString="F0"
                                               ClipValueToMinMax="True"
                                               Width="150" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                  <!-- Register: AttenuationAndSoundIndexDI2 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationAndSoundIndexDI2</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Sound index and attenuation to be played when triggering DI2 [Att R] [Att L] [Index]</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <Border CornerRadius="3" Padding="5" MaxHeight="200">
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding AttenuationAndSoundIndexDI2Collection}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="50,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='[{0}]:'}"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Value}"
                                               Minimum="0"
                                               Maximum="65535"
                                               Increment="1"
                                               FormatString="F0"
                                               ClipValueToMinMax="True"
                                               Width="150" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                  <!-- Register: AttenuationBoth (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationBoth</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Configures both attenuation on right and left channels [Att R] [Att L]</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <Border CornerRadius="3" Padding="5" MaxHeight="200">
                      <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding AttenuationBothCollection}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="50,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='[{0}]:'}"
                                           VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Value}"
                                               Minimum="0"
                                               Maximum="65535"
                                               Increment="1"
                                               FormatString="F0"
                                               ClipValueToMinMax="True"
                                               Width="150" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                  <!-- Register: AttenuationLeft (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationLeft</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Configure left channel's attenuation (1 LSB is 0.1dB)</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding AttenuationLeft}"
                                   Minimum="0"
                                   Maximum="65535"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: AttenuationLeftDI0 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationLeftDI0</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Left channel's attenuation (1 LSB is 0.5dB) when triggering DI0</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding AttenuationLeftDI0}"
                                   Minimum="0"
                                   Maximum="65535"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: AttenuationLeftDI1 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationLeftDI1</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Left channel's attenuation (1 LSB is 0.5dB) when triggering DI1</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding AttenuationLeftDI1}"
                                   Minimum="0"
                                   Maximum="65535"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: AttenuationLeftDI2 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationLeftDI2</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Left channel's attenuation (1 LSB is 0.5dB) when triggering DI2</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding AttenuationLeftDI2}"
                                   Minimum="0"
                                   Maximum="65535"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: AttenuationRight (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">AttenuationRight</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Configure right channel's attenuation (1 LSB is 0.1dB)</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <NumericUpDown Value="{Binding AttenuationRight}"
                                   Minimum="0"
                                   Maximum="65535"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
