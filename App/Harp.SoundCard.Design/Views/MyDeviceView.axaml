                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
                  <!-- Register: Commands (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">Commands</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Send commands to PIC32 micro-controller</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <ComboBox SelectedItem="{Binding Commands, Mode=TwoWay}"
                              IsEnabled="True"
                              Width="200"
                              Margin="0,5,0,0"
                              HorizontalAlignment="Left">
                      <x:Static Member="local:ControllerCommand.DisableBootloader" />
                      <x:Static Member="local:ControllerCommand.EnableBootloader" />
                      <x:Static Member="local:ControllerCommand.DeleteAllSounds" />
                    </ComboBox>
                  </StackPanel>
                  <!-- Register: ConfigureAdc (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">ConfigureAdc</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Configuration of Analog Inputs</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <ComboBox SelectedItem="{Binding ConfigureAdc, Mode=TwoWay}"
                              IsEnabled="True"
                              Width="200"
                              Margin="0,5,0,0"
                              HorizontalAlignment="Left">
                      <x:Static Member="local:AdcConfiguration.NotUsed" />
                      <x:Static Member="local:AdcConfiguration.AdcAdc" />
                      <x:Static Member="local:AdcConfiguration.AmplitudeBothAdc" />
                      <x:Static Member="local:AdcConfiguration.AmplitudeLeftAdc" />
                      <x:Static Member="local:AdcConfiguration.AmplitudeRightAdc" />
                      <x:Static Member="local:AdcConfiguration.AmplitudeLeftAmplitudeRight" />
                      <x:Static Member="local:AdcConfiguration.AmplitudeBothFrequency" />
                    </ComboBox>
                  </StackPanel>
                  <!-- Register: ConfigureDI0 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">ConfigureDI0</Label>
                      <heroIcons:HeroIcon Type="InformationCircle" Width="14" Height="14"
                                          Foreground="{Binding IconColor}"
                                          VerticalAlignment="Top">
                        <ToolTip.Tip>Configuration of the digital input 0 (DI0)</ToolTip.Tip>
                      </heroIcons:HeroIcon>
                    </StackPanel>
                    <ComboBox SelectedItem="{Binding ConfigureDI0, Mode=TwoWay}"
                              IsEnabled="True"
                              Width="200"
                              Margin="0,5,0,0"
                              HorizontalAlignment="Left">
                      <ComboBox.Resources>
                        <conv:EnumDisplayConverter x:Key="EnumDisplayConverter">
                          <conv:EnumDisplayConverter.Mappings>
                            <system:String x:Key="Digital">Used as a pure digital input.</system:String>
                            <system:String x:Key="StartAndStopSound">Starts sound when rising edge and stop when falling edge.</system:String>
                            <system:String x:Key="StartSound">Starts sound when rising edge.</system:String>
                            <system:String x:Key="Stop">Stops sound or frequency when rising edge.</system:String>
                            <system:String x:Key="StartAndStopFrequency">Starts frequency when rising edge and stop when falling edge.</system:String>
                            <system:String x:Key="StartFrequency">Starts frequency when rising edge.</system:String>
                          </conv:EnumDisplayConverter.Mappings>
                        </conv:EnumDisplayConverter>
                      </ComboBox.Resources>
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <x:Static Member="local:DigitalInputConfiguration.Digital" />
                      <x:Static Member="local:DigitalInputConfiguration.StartAndStopSound" />
                      <x:Static Member="local:DigitalInputConfiguration.StartSound" />
                      <x:Static Member="local:DigitalInputConfiguration.Stop" />
                      <x:Static Member="local:DigitalInputConfiguration.StartAndStopFrequency" />
                      <x:Static Member="local:DigitalInputConfiguration.StartFrequency" />
                    </ComboBox>
                  </StackPanel>
                  <!-- Register: ConfigureDI1 (Write) -->
                  <StackPanel Orientation="Vertical" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Label FontWeight="Bold" FontSize="14" Padding="0">ConfigureDI1</Label>
