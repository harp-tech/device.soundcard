                    <NumericUpDown Value="{Binding AttenuationRightDI1}"
                                   Minimum="0"
                                   Maximum="65535"
                                   ClipValueToMinMax="True"
                                   Increment="1"
                                   FormatString="F0"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   Margin="0,5,0,0" />
                  </StackPanel>
